def mostrar_mapa(mapa):
    for linha in mapa:
        print(" ".join(linha))
    print()


def mover(linha, coluna, jogador):
    if jogador == "W":
        return linha - 1, coluna
    elif jogador == "S":
        return linha + 1, coluna
    elif jogador == "A":
        return linha, coluna - 1
    elif jogador == "D":
        return linha, coluna + 1

    return linha, coluna

